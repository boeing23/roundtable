# Copy to .env.local and fill in the keys you have. Any subset works;
# models without a key show as unavailable in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Your own Tailscale login (see REMOTE.md). Local requests are treated as this
# user, so the same workspace shows up on your laptop and your phone.
PRIMARY_USER=
